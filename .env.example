# =========================================================
# MedVault Environment Variables - Example
# =========================================================
# IMPORTANT:
# - This file is SAFE to commit/share.
# - NEVER put real passwords, API keys, tokens, or private keys here.
# - Configure real secrets through AI Studio Secrets / server environment.
# =========================================================

# ---------------------------------------------------------
# Gemini AI
# ---------------------------------------------------------
# Required for Gemini AI API calls.
# The real API key must NOT be stored in source code.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# (ไม่บังคับ) ชื่อโมเดล Gemini — ว่างไว้ = ใช้ค่าเริ่มต้นใน functions/api.js
GEMINI_MODEL=

# บน Cloud Functions ให้ตั้งค่า key ด้วยคำสั่ง:
#   firebase functions:secrets:set GEMINI_API_KEY


# ---------------------------------------------------------
# Firebase App Check (reCAPTCHA Enterprise site key — เป็นค่าสาธารณะ)
# ---------------------------------------------------------
VITE_RECAPTCHA_SITE_KEY=

# หมายเหตุ: ห้ามใส่รหัสผ่านใดๆ ในตัวแปรที่ขึ้นต้นด้วย VITE_
# เพราะจะถูกฝังลงในไฟล์ JavaScript ที่ผู้ใช้ทุกคนดาวน์โหลดได้


# ---------------------------------------------------------
# Application
# ---------------------------------------------------------
# URL where the application is hosted.
# Development example:
APP_URL=http://localhost:5000


# ---------------------------------------------------------
# Cloud SQL
# ---------------------------------------------------------
# Leave these empty if Cloud SQL is not being used.
SQL_HOST=
SQL_DB_NAME=
SQL_USER=

# NEVER put the real database password in this file.
SQL_PASSWORD=

SQL_ADMIN_USER=

# NEVER put the real database admin password in this file.
SQL_ADMIN_PASSWORD=
